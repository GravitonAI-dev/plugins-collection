#!/usr/bin/env bash
# Corta el push de todo commit no marcado con scripts/marcar_revisado.sh (README, seccion 10).
# Se activa una vez por clon: git config core.hooksPath scripts/hooks
registro="$(git rev-parse --git-common-dir)/revisiones-ok"
while read -r ref_local sha_local ref_remota sha_remota; do
  [ "$sha_local" = 0000000000000000000000000000000000000000 ] && continue  # borrar una rama remota no sube codigo
  commit=$(git rev-parse "$sha_local^{commit}" 2>/dev/null) || continue      # una etiqueta se comprueba por su commit
  if ! grep -q "^$commit " "$registro" 2>/dev/null; then
    echo "PUSH CORTADO: $(git log -1 --format='%h %s' "$commit" | cut -c1-80)" >&2
    echo "no esta marcado. Pasa /simplify y /code-review, commitea y ejecuta scripts/marcar_revisado.sh." >&2
    exit 1
  fi
done
